[sub_resource type="Shader" id="Shader_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_tex : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_lod : hint_range(0.0, 6.0) = 3.0;
uniform float darken : hint_range(0.0, 1.0) = 0.35;

void fragment() {
	vec2 px = SCREEN_PIXEL_SIZE * exp2(blur_lod);
	vec3 c = textureLod(screen_tex, SCREEN_UV, blur_lod).rgb * 0.4;
	c += textureLod(screen_tex, SCREEN_UV + vec2(px.x, 0.0), blur_lod).rgb * 0.15;
	c += textureLod(screen_tex, SCREEN_UV - vec2(px.x, 0.0), blur_lod).rgb * 0.15;
	c += textureLod(screen_tex, SCREEN_UV + vec2(0.0, px.y), blur_lod).rgb * 0.15;
	c += textureLod(screen_tex, SCREEN_UV - vec2(0.0, px.y), blur_lod).rgb * 0.15;
	COLOR = vec4(c * (1.0 - darken), 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_blur"]
shader = SubResource("Shader_blur")
shader_parameter/blur_lod = 3.0
shader_parameter/darken = 0.35

